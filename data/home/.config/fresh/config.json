{
  // Suitable for Fresh 0.4.9
  //
  // cSpell: enabled
  "version": 2,
  "check_for_updates": false,
  "self_update": false,
  "theme": "terminal-light.json",
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "show_hidden": true,
    "side": "right"
  },
  "editor": {
    // * cursor
    "cursor_style": "steady_bar",
    // * wrap & rules
    "wrap_column": 110,
    "rulers": [],
    "line_wrap": false,
    // * brackets
    "rainbow_brackets": true,
    // * indentation & whitespaces
    "indentation_guide": "all",
    "whitespace_spaces_leading": true,
    "whitespace_spaces_inner": false,
    "whitespace_spaces_trailing": true,
    "whitespace_tabs_leading": true,
    "whitespace_tabs_inner": false,
    "whitespace_tabs_traling": true,
    // * on-save
    "trim_trailing_whitespace_on_save": true,
    "ensure_final_newline_on_save": true,
    // * hints & diagnostics
    "enable_inlay_hints": true,
    "diagnostics_inline_text": true,
    "completion_popup_auto_show": true,
    // * tabs
    "tab_size": 2,
    // * menus & bars
    "show_menu_bar": false,
    "show_vertical_scrollbar": false,
    "show_tilde": false,
    "nerd_font_icons": true,
    "rainbow_indentation": true,
    "status_bar": {
      "left": [
        "{remote}",
        "{diagnostics}",
        "{lsp}",
        "{warnings}",
        "{terminal_restart}"
      ],
      "right": [
        "{cursor:compact}",
        "{read_only}",
        "{encoding}",
        "{line_ending}",
        "{language}"
      ]
    },
    // * theme
    "use_terminal_bg": false
  },
  "languages": {
    "bash": {
      "extensions": [
        "sh",
        "bash",
        "env"
      ]
    },
    "ini": {
      "extensions": [
        "ini",
        "cf",
        "conf"
      ]
    }
  },
  "terminal": {
    "shell": {
      "command": "bash",
      "args": []
    }
  },
  "lsp": {
    "rust": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    },
    "json": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "plugins": {
    "orchestrator": {
      "enabled": false
    },
    "vi_mode": {
      "enabled": false
    }
  },
  // ? key bindings
  //
  // Ctrl       => peek / show
  // Ctrl+Shift => go to
  "active_keybinding_map": "vscode",
  "keybindings": [
    {
      "key": ",",
      "modifiers": ["ctrl", "shift"],
      "action": "open_settings",
      "when": "normal"
    },
    {
      "key": ",",
      "modifiers": ["ctrl", "shift"],
      "action": "open_settings",
      "when": "global"
    },
    {
      "key": ";",
      "modifiers": ["ctrl"],
      "action": "open_settings",
      "when": "normal"
    },
    {
      "key": ";",
      "modifiers": ["ctrl"],
      "action": "open_settings",
      "when": "global"
    },
    {
      "key": "ü",
      "modifiers": ["ctrl"],
      "action": "lsp_hover",
      "when": "normal"
    },
    {
      "key": "ü",
      "modifiers": ["ctrl", "shift"],
      "action": "lsp_references",
      "when": "normal"
    },
    {
      "key": "-",
      "modifiers": ["ctrl", "alt"],
      "action": "navigate_back",
      "when": "normal"
    },
    {
      "key": "ä",
      "modifiers": ["ctrl"],
      "action": "lsp_goto_definition",
      "when": "normal"
    },
    {
      "key": "ä",
      "modifiers": ["ctrl", "shift"],
      "action": "lsp_goto_definition",
      "when": "normal"
    },
    {
      "key": "ö",
      "modifiers": ["ctrl"],
      "action": "lsp_implementation",
      "when": "normal"
    },
    {
      "key": "ö",
      "modifiers": ["ctrl", "shift"],
      "action": "lsp_implementation",
      "when": "normal"
    },
    {
      "key": "i",
      "modifiers": ["ctrl", "shift"],
      "action": "format_buffer",
      "when": "normal"
    },
    {
      "keys": [
        {
          "key": "k",
          "modifiers": ["ctrl"]
        },
        {
          "key": "r",
          "modifiers": ["ctrl"]
        }
      ],
      "action": "lsp_rename",
      "when": "normal"
    },
    {
      "key": "Up",
      "modifiers": ["ctrl", "shift"],
      "action": "add_cursor_above",
      "when": "normal"
    },
    {
      "key": "Down",
      "modifiers": ["ctrl", "shift"],
      "action": "add_cursor_below",
      "when": "normal"
    },
    {
      "key": " ",
      "modifiers": ["ctrl", "alt"],
      "action": "open_live_grep",
      "when": "global"
    },
    {
      "key": "n",
      "modifiers": ["ctrl", "alt"],
      "action": "file_explorer_new_file",
      "when": "file_explorer"
    },
    {
      "key": "n",
      "modifiers": ["ctrl", "shift", "alt"],
      "action": "file_explorer_new_directory",
      "when": "file_explorer"
    },
    {
      "key": "delete",
      "modifiers": ["shift"],
      "action": "delete_line"
    },
    {
      "key": "w",
      "modifiers": ["ctrl"],
      "action": "close_tab"
    },
    {
      "key": "=",
      "modifiers": ["ctrl"],
      "action": "toggle_utility_dock",
      "when": "global"
    },
    {
      "key": "=",
      "modifiers": ["ctrl", "shift"],
      "action": "open_terminal_in_dock",
      "when": "global"
    },
    {
      "key": "w",
      "modifiers": ["ctrl"],
      "action": "close_terminal",
      "when": "terminal"
    },
    {
      "key": "p",
      "modifiers": ["ctrl", "shift"],
      "action": "quick_open",
      "when": "global"
    },
    {
      "key": "p",
      "modifiers": ["ctrl"],
      "action": "quick_open_files",
      "when": "global"
    },
    {
      "key": "e",
      "modifiers": ["ctrl", "shift"],
      "action": "focus_file_explorer",
      "when": "normal"
    },
    {
      "key": "Tab",
      "modifiers": ["ctrl"],
      "action": "switch_to_previous_tab",
      "when": "normal"
    },
    {
      "key": "j",
      "modifiers": ["ctrl", "shift"],
      "action": "switch_to_tab_by_name",
      "when": "global"
    },
    {
      "key": "e",
      "modifiers": ["ctrl", "shift"],
      "action": "focus_editor",
      "when": "file_explorer"
    },
    {
      "key": "q",
      "modifiers": ["ctrl", "shift"],
      "action": "quit",
      "when": "normal"
    }
  ]
}
