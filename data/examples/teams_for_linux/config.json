{
  "disableNotifications": false,
  "disableNotificationSoundIfNotAvailable": true,
  "notificationMethod": "electron",
  "disableGpu": false,
  "electronCLIFlags": [
    [
      "enable-features",
      "WebRTCPipeWireCapturer,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,AcceleratedVideoEncoder"
    ]
  ],
  "logConfig": {
    "transports": {
      "console": {
        "level": "warn"
      }
    }
  }
}
